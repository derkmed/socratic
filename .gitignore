# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Local secrets for docker compose: the two tokens and the API key
# `compose.yaml` interpolates. Ignored in the tree rather than in a local
# `info/exclude`, because an exclude file protects one clone and travels to
# none of the others.
.env
.env.*
!.env.example
