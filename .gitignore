# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Local secrets for docker compose: the two tokens and the API key
# `compose.yaml` interpolates. Ignored in the tree rather than in a local
# `info/exclude`, because an exclude file protects one clone and travels to
# none of the others.
.env
.env.*
!.env.example

# The collected records trail (#117, ADR-0018): `compose.yaml` bind-mounts this
# for the quiz service to write attempts and ratings into. Untracked rather than
# absent — the whole record goes to disk, answer keys included, and that being
# untracked is the only control on it.
/data/

# Agent worktrees: checkouts a subagent works in, regenerable and per-machine.
.claude/worktrees/
